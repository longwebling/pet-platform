<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pethelp.message.mapper.ConversationMapper">

    <select id="findById" resultType="com.pethelp.message.entity.Conversation">
        SELECT id, post_id, created_at
        FROM conversations
        WHERE id = #{id}
    </select>

</mapper>
